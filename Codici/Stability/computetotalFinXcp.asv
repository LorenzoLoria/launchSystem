function Xcp_total = computetotalFinXcp(opt, mission, vlauncher, vsound)
% Computes the total center of pressure of the vehicle including fins for both stages
%
% Inputs:
%   opt       : options structure (contains nStages)
%   mission   : mission structure (contains geometry, aerodynamics, etc.)
%   vlauncher : launcher speed [m/s]
%   vsound    : speed of sound [m/s]
%
% Output:
%   Xcp_total : combined center of pressure [m]

    N = opt.nStages; % Current stage number (2=both stages, 1=stage 2 only, 0=no stages)

    % --- Body CP
    Xcp_body = computeXcpcomputeXcp(mission, opt);
    delta_le = mission.aerodynamics.finsGeomStage.delta_le;
    lambda_le = mission.aerodynamics.finsGeomStage.lambda_le;
    be1   = mission.aerodynamics.finsGeomStage.be;
    Se1   = mission.aerodynamics.finsGeomStage.Se;

    % --- Fin CP and normal force coefficient
    % Stage 1 fins (main fins)
    if N >= 1
        cmac1 = mission.aerodynamics.finsGeomStage1.cmac;
        be1   = mission.aerodynamics.finsGeomStage1.be;
        Se1   = mission.aerodynamics.finsGeomStage1.Se;
        tmac1 = mission.aerodynamics.finsGeomStage1.tmac;

        Xcp_fin1 = computeFinXcp(vlauncher, vsound, cmac1, be1, Se1);
        [CN_fin1, ~, ~] = AerodynCoefFins_new(...
            mission.alpha, be1^2/Se1, vlauncher, vsound, Se1, ...
            0.5*1.225*vlauncher^2, mission.aerodynamics.bodyGeom.Aref, ...
            cmac1, delta_le, lambda_le, be1/2, tmac1 ...
        );
    end

    % Stage 2 fins (canard fins)
    if N == 2
        cmac2 = mission.aerodynamics.finsGeomStage2.cmac;
        be2   = d2/d1*be1;
        Se2   = mission.aerodynamics.finsGeomStage2.Se;
        delta_le2 = mission.aerodynamics.finsGeomStage2.delta_le;
        lambda_le2 = mission.aerodynamics.finsGeomStage2.lambda_le;
        tmac2 = mission.aerodynamics.finsGeomStage2.tmac;

        Xcp_fin2 = computeFinXcp(vlauncher, vsound, cmac2, be2, Se2);
        [CN_fin2, ~, ~] = AerodynCoefFins_new(...
            mission.alpha, be2^2/Se2, vlauncher, vsound, Se2, ...
            0.5*1.225*vlauncher^2, mission.aerodynamics.bodyGeom.Aref, ...
            cmac2, delta_le, lambda_le, be2/2, tmac2 ...
        );
    end

    % --- Weighted average to get total Xcp
    S_body = mission.aerodynamics.bodyGeom.Aref;

    if N == 2
        % Both stages present: include both fin pairs
        Xcp_total = (Xcp_body*S_body + Xcp_fin1*Se1*CN_fin1 + Xcp_fin2*Se2*CN_fin2) / ...
                    (S_body + Se1*CN_fin1 + Se2*CN_fin2);
    elseif N == 1
        % Only stage 2 present: include only stage 1 fins (main fins)
        Xcp_total = (Xcp_body*S_body + Xcp_fin1*Se1*CN_fin1) / ...
                    (S_body + Se1*CN_fin1);
    else
        % No stages: total CP = body CP
        Xcp_total = Xcp_body;
    end
end
